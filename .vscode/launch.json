{
  "version": "0.2.0",
  "configurations": [
    {
      "cwd": "${workspaceRoot}",
      "type": "cortex-debug",
      "request": "launch",
      "name": "ins_task: OpenOCD",
      "servertype": "openocd",
      "executable": "build/ins_task/ins_task.elf",
      "runToEntryPoint": "main",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/stm32f4x.cfg"
      ],
      "toolchainPrefix": "arm-none-eabi",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 1
      }
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "d:/cube_Projects/R2_kfs/application",
      "program": "d:/cube_Projects/R2_kfs/application/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}